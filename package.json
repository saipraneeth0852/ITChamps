{
  "name": "itchmaps",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x || 22.x"
  },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "build:hostinger": "npm run build && mkdir -p .next/standalone/.next && cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
    "build:vps": "npm run build && mkdir -p .next/standalone/.next && cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
    "start": "node node_modules/next/dist/bin/next start",
    "start:hostinger": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "start:vps": "HOSTNAME=0.0.0.0 PORT=3000 node .next/standalone/server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop itchamps",
    "pm2:restart": "pm2 restart itchamps",
    "pm2:logs": "pm2 logs itchamps",
    "lint": "eslint .",
    "seed:firebase": "node --env-file=.env.local scripts/seed-firestore.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed-pg.mjs"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.9.4",
    "next": "^16.2.6",
    "pdfkit": "^0.18.0",
    "pg": "^8.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.6",
    "typescript": "^5.0.0"
  }
}
